diff --git a/lib/analytics/google-analytics.ts b/lib/analytics/google-analytics.ts
new file mode 100644
index 0000000..1e55e99
--- /dev/null
+++ b/lib/analytics/google-analytics.ts
@@ -0,0 +1,98 @@
+export type AnalyticsEventName =
+  | 'search_filter_changed'
+  | 'department_filter_changed'
+  | 'groups_filter_changed'
+  | 'pagination_changed'
+  | 'page_size_changed'
+  | 'course_classes_opened'
+  | 'whatsapp_group_opened'
+  | 'add_link_form_opened'
+  | 'link_submitted'
+  | 'report_form_opened'
+  | 'report_submitted'
+  | 'feedback_submitted'
+
+type AnalyticsParameterValue = string | number | boolean
+type AnalyticsParameters = Record<string, AnalyticsParameterValue | null | undefined>
+
+const MAX_PARAMETER_STRING_LENGTH = 100
+const BLOCKED_PARAMETER_NAMES = new Set([
+  'email',
+  'name',
+  'nome',
+  'url',
+  'link',
+  'link_url',
+  'reason',
+  'motivo',
+  'query',
+  'search_term',
+  'professor',
+  'user_id',
+  'ip',
+  'ip_address',
+])
+
+declare global {
+  interface Window {
+    dataLayer?: unknown[]
+    gtag?: (...args: unknown[]) => void
+  }
+}
+
+function isBlockedParameter(parameterName: string): boolean {
+  const normalizedName = parameterName.trim().toLowerCase()
+
+  return (
+    BLOCKED_PARAMETER_NAMES.has(normalizedName) ||
+    normalizedName.endsWith('_url') ||
+    normalizedName.includes('whatsapp_link') ||
+    normalizedName.includes('report_reason') ||
+    normalizedName.includes('feedback_text')
+  )
+}
+
+export function sanitizeAnalyticsParameters(
+  parameters: AnalyticsParameters,
+): Record<string, AnalyticsParameterValue> {
+  const sanitizedEntries: Array<[string, AnalyticsParameterValue]> = []
+
+  for (const [parameterName, value] of Object.entries(parameters)) {
+    if (
+      value === null ||
+      value === undefined ||
+      isBlockedParameter(parameterName)
+    ) {
+      continue
+    }
+
+    if (typeof value === 'string') {
+      const sanitizedValue = value
+        .replace(/[\u0000-\u001F\u007F]/g, ' ')
+        .trim()
+        .slice(0, MAX_PARAMETER_STRING_LENGTH)
+
+      if (sanitizedValue) {
+        sanitizedEntries.push([parameterName, sanitizedValue])
+      }
+      continue
+    }
+
+    sanitizedEntries.push([parameterName, value])
+  }
+
+  return Object.fromEntries(sanitizedEntries)
+}
+
+export function trackAnalyticsEvent(
+  eventName: AnalyticsEventName,
+  parameters: AnalyticsParameters = {},
+): void {
+  if (typeof window === 'undefined' || typeof window.gtag !== 'function') return
+
+  window.gtag('event', eventName, {
+    ...sanitizeAnalyticsParameters(parameters),
+    page_location: `${window.location.origin}${window.location.pathname}`,
+    page_title: document.title,
+  })
+}
